{
  "name": "Atividade React",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Vite", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["MS-CEINTL.vscode-language-pack-pt-BR", "dbaeumer.vscode-eslint"]
    }
  }
}
